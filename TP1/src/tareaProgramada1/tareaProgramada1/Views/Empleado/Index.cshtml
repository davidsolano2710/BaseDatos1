@model IEnumerable<tareaProgramada1.Models.Empleado>

@{
    ViewData["Title"] = "Lista de Empleados";
}

<h2>Lista de Empleados</h2>

@if (TempData["Exito"] is string mensaje)
{
    <div class="alert alert-success" role="status">
        @mensaje
    </div>
}

@if (ViewData["ErrorListado"] is string errorListado)
{
    <div class="alert alert-danger" role="alert">
        @errorListado
    </div>
}

<a asp-controller="Empleado"
   asp-action="Insertar"
   class="btn btn-primary mb-3">
    Insertar Empleado
</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Salario</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.Id</td>
                <td>@emp.Nombre</td>
                <td>@emp.Salario</td>
            </tr>
        }
    </tbody>
</table>